# ---------------------------------------------------------------------------
# FLOCKRAFT environment
# ---------------------------------------------------------------------------
# Public values are inlined into the browser bundle. Anything secret must NOT
# carry the NEXT_PUBLIC_ prefix and must only be read on the server.

# --- Public (safe to expose) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional raster tile template for the MAP screen, e.g.
#   https://tile.example.com/{z}/{x}/{y}.png
# Leave empty to render the vector reference grid only. Do not embed an API key
# that is billed per request without a referrer restriction on the provider.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Server only (never expose) --------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
